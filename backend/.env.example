# Copy this file to .env and adjust as needed.
# docker-compose reads this file and injects it into the backend container.

ENVIRONMENT=development
DEBUG=true

# Postgres — these values must match the `db` service in docker-compose.yml
POSTGRES_USER=passhive
POSTGRES_PASSWORD=passhive
POSTGRES_DB=passhive
POSTGRES_HOST=db
POSTGRES_PORT=5432

JWT_SECRET_KEY=pass-hive-jwt-secret-key-2026
# SQLAlchemy async connection string, built from the values above.
# (In config.py we assemble this automatically, this line is just for reference.)
# postgresql+asyncpg://passhive:passhive@db:5432/passhive
